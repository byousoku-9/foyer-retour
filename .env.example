# Copier en .env — jamais commité. Lu depuis la racine du repo par server/app/config.py
# (serveur, `python -m server.app.llm.models --check`, enregistrement des fixtures de tests).

# Clé API Anthropic : console.anthropic.com > API keys. Régler aussi un plafond de dépense
# mensuel dans la console (Settings > Limits) — c'est le plafond fournisseur d'AD-13.
ANTHROPIC_API_KEY=

# ENV=dev | prod ; ALLOW_UNGATED (dérogation d'AD-7 : servir un document sans gate valide).
#
# Depuis la story 1.10, les deux documents portent un gate `vertical` écrit par
# `python -m server.evals.run --gate {doc_id}`, et l'AC de la story ferme la dérogation : **en
# `prod`, elle est refusée**, que la variable soit absente, `false` ou `true` (`config.py` force
# `allow_ungated=False`). Elle ne vaut donc plus qu'en `ENV=dev`, où elle est vraie par défaut.
# Le refus n'est pas muet : `ENV=prod` + `ALLOW_UNGATED=true` produit l'alerte
# `ungated_refuse_en_production` sur `/api/v1/sante`, affichée par la page d'accueil, et un
# avertissement au journal de démarrage. Le jour où une réingestion invalide un gate en production,
# le chemin est de relancer les témoins (`--gate`), pas d'armer une dérogation.
ENV=dev
# ALLOW_UNGATED=true

# Empreinte courte du commit servi, publiée par `/api/v1/sante` (`version`, AD-11). L'image la reçoit
# du déploiement (`deploy.yml` pose `GIT_SHA=<sha7>` en variable du service Cloud Run) et le smoke
# test la compare au SHA du commit qui l'a déclenché : sans elle, on mesurerait une révision qu'on
# n'a pas construite. Hors conteneur, `config.py` retombe sur `dev` — inutile de la poser en local.
# GIT_SHA=

# Taux USD → EUR appliqué aux prix USD/MTok d'Anthropic (AD-9). Valeur du 23/08/2026 (BCE, arrondie) ;
# à mettre à jour à la main, il n'est pas lu en ligne.
USD_EUR=0.92

# Seuils [HYPOTHÈSE] et temps, surchargeables par variable d'environnement (voir server/app/config.py) :
# DEADLINE_S=290 (story 5.6 T1d : navigation en 6–8 tours + vérificateur à l'effort `medium` re-borné
#   à 6 144 tokens, 289,0 s majorées ; les quatre majorations empilées tiennent lieu de marge)
# LLM_TIMEOUT_S=78 (borne l'appel, pas la chaîne — 77,3 s pour la plus longue sortie d'étape, 6 144)
# CLIENT_ABORT_MARGIN_S=25 — le navigateur abandonne à DEADLINE_S + cette marge, soit 315 s, au-dessus
#   du `--timeout=300` de Cloud Run : AD-11 exige client > Cloud Run > serveur. Ce n'est pas un seuil
#   propre mais un **reste**, et il n'en reste plus : la prochaine hausse de DEADLINE_S demandera de
#   relever le `--timeout` de Cloud Run
# CLIENT_PROBE_TIMEOUT_S=10 — budget d'un petit GET du front (`/sante`, `/documents`, rapport
#   d'ingestion) ; il empruntait la marge ci-dessus tant qu'elles valaient toutes deux 10 s
# MAX_LLM_ATTEMPTS=15 (comprendre + 8 tours de navigation + ébauche, vérifier, relance d'AD-3, reprise 4.2e + 1 retry parse)
# Navigation par le modèle (chemin servi, amendement AD-1 du 03/09/2026) : NAVIGATION_MAX_LLM_TURNS=8
# NAVIGATION_BUDGET_TOKENS=12000 (budget de lecture, appliqué au refus)  NAVIGATION_SEARCH_LIMIT=20  NAVIGATION_TIER=reason
# Place de l'ébauche de navigation, re-dérivée sur les trois réponses A16 du pipeline (T1b) :
# NAVIGATION_DRAFT_MAX_CLAIMS=6 (2 sous-questions × 3 clauses décisionnelles : base, option, exclusion/condition)
# NAVIGATION_DRAFT_MAX_SEGMENTS=9 (6 segments factuels + les 2 transitions mesurées + le segment limite)
# NAVIGATION_REDIGER_MAX_TOKENS=5056 (3200 de contrat JSON à 6 claims + 1856 de réserve de réflexion,
#   re-dérivé T13 sur le gate Baloise ; la mesure prescrit 5888, la deadline n'en laisse que 5117)
# NAVIGATION_DRAFT_EFFORT=medium (effort du seul tour terminal, mesuré à 0 token de réflexion ; repli : medium)
# RETROUVER_OUTILS_TIER=reason  RETROUVER_OUTILS_MAX_TOKENS=1024 (tours d'outils de la navigation)
# VARIANTE_NOMBRE_MAX_PART=0.01 — au-delà de cette part des blocs, un mot est trop fréquent pour
#   que sa forme de nombre élargisse utilement une requête de `chercher` (le reste des seuils
#   FACETTE_*, PROFIL_MAX_OPENS et ENUMERATION_MAX_TOKENS est parti avec les passes de choix, T2)
# QUOTE_MIN_CHARS=25  QUOTE_MIN_RATIO=0.6  MAX_OPENS=6  NODE_WINDOW=30  SEARCH_LIMIT=20
# MAX_COST_EUR_PER_REQUEST=1.30  COST_ALERT_EUR=1.00  RATE_LIMIT_PER_MINUTE=10  RATE_LIMIT_PER_DAY=100
#   (03/09/2026, T7 : re-dérivés sur le chemin **froid** de la navigation — le premier tour écrit le
#   préfixe de sommaire au tarif d'écriture de cache 1 h, ≈ 0,28 €. Voir `config.py`.)
# Client LLM (story 1.3) : LLM_MAX_OUTPUT_TOKENS=6144 (plafond de sûreté ; suit la plus longue sortie
#   d'étape, VERIFIER_SINISTRE_JSON_TOKENS + VERIFIER_THINKING_RESERVE_TOKENS = 1024 + 5120)
# LLM_RETRY_MARGIN_S=5  ESTIMATE_CHARS_PER_TOKEN=2
# ESTIMATE_TOKENIZER_FACTOR=1.3  COUNT_TOKENS_TIMEOUT_S=10
# Étapes (sortie maximale par appel) : COMPRENDRE_MAX_TOKENS=1024
# REDIGER_MAX_TOKENS=2048 (autorité unique du guide et de l'ébauche terminale de navigation)
# RETRIEVAL_MAX_BLOCKS=30 (borne de rappel ; le coût variable est piloté par le majorant de tokens)
# RETRIEVAL_MAX_TOKENS=3500 (majorant adaptatif des blocs rendus — AD-1 borne aussi les tokens)
# Bornes annoncées aux prompts des étapes : QUOTE_MAX_CHARS=250  DRAFT_MAX_SEGMENTS=9  DRAFT_MAX_CLAIMS=6
#   (>= les bornes de navigation : `pipelines/sinistre.py` borne la fusion de relance sur ces deux-ci)
# QUESTION_MIN_TERMS=2  QUESTION_MAX_TERMS=6  QUESTION_MAX_FACETTES=4 (le barème de complete, AD-4)
# Pipeline guide (story 1.5) : GUIDE_DOC_ID=lux-guide  HISTORIQUE_MAX_TURNS=6 (400 au-delà, jamais tronqué)
# VERIFIER_MAX_CLAIMS=8 (bornes de l'appel de pertinence groupé, >= DRAFT_MAX_CLAIMS)  VERIFIER_MAX_TOKENS=3072
# RELANCE_SUR_NON_PERTINENCE=false ([HYPOTHÈSE] : relancer *rédiger* pour une claim écartée par le seul
#   jugement de pertinence coûte un second appel `reason` ; à mesurer avec les questions-témoins (4.2))
# Sommaires (story 1.3, entrent dans ingest_fingerprint) : SUMMARY_MAX_TAGS=5  SUMMARY_RESUME_MAX_CHARS=90
# SUMMARY_MAX_LEVEL=2
# Ingestion PDF générique (story 3.1) : OCR uniquement sur une page visuelle sans couche texte,
# tables atomiques, pages mixtes et contrôles de qualité non bloquants.
# MIXED_PAGE_IMAGE_DENSITY=0.20  OCR_DPI=300  COVERAGE_THRESHOLD=0.80
# TOC_PAGE_NUMBER_BASELINE_PT=8  TOC_COLUMN_TOLERANCE_PT=80  TOC_INDENT_TOLERANCE_PT=5
# TOC_LINE_GAP_RATIO=1.5  TOC_TITLE_PREFIX_MIN_CHARS=20
# QUALITY_MIN_WORDS=12  FOREIGN_SIGNAL_MIN=3  FRENCH_SIGNAL_RATIO_MIN=0.08  GIBBERISH_RATIO_MAX=0.35
# RESIDUAL_HEADER_MIN_PAGES_RATIO=0.30
# Questions-témoins (story 1.10, AD-9/AD-14) : EVALS_MAX_COST_EUR=20.0 (et LIVE_BUDGET_EUR=20.0, le
#   plus petit des deux décide) — plafond de coût **par run**,
#   qui remplace le plafond par requête pendant une éval ; `--max-cost` le surcharge pour un run.
#   Les évals refusent de tourner sans ANTHROPIC_API_KEY : `ANTHROPIC_API_KEY= python -m server.evals.run`
#   sort en code 2 sans charger le corpus (les tests unitaires, eux, passent sans clé).
# Dictionnaire enrichi (story 2.1, AD-5/AD-7) — bornes que le **code** applique à ce que le modèle
#   d'ingestion rend, et garde-fous du run hors ligne. Une chaîne hors borne est écartée, jamais
#   tronquée, et le run affiche le compte des écarts.
# DICTIONARY_TERM_MAX_CHARS=60  DICTIONARY_TERM_MAX_WORDS=4 (aussi la ligne de partage du contrôle
#   « chaîne recopiée d'un bloc » : au-delà de 4 mots, une chaîne présente telle quelle dans un bloc
#   est un passage du guide, pas un terme du domaine)
# DICTIONARY_MAX_VARIANTS_PER_TERM=8  DICTIONARY_MAX_TERMS_PER_FICHE=20
# DICTIONARY_QUESTION_MAX_CHARS=160  DICTIONARY_MAX_QUESTIONS_PER_FICHE=5
# DICTIONARY_MAX_INTENT_TRIGGERS=30
# DICTIONARY_MAX_OUTPUT_TOKENS=16000 (sortie d'une requête de batch ; **pas** borné par
#   LLM_MAX_OUTPUT_TOKENS, qui borne les appels du serveur sous la deadline et le plafond par requête)
# DICTIONARY_MAX_COST_EUR=3.0 (majorant du run entier, vérifié **avant** toute soumission : le run
#   refuse de démarrer plutôt que de découvrir la facture après coup — `--max-cost` le surcharge)
# DICTIONARY_BATCH_POLL_S=20.0  DICTIONARY_BATCH_TIMEOUT_S=3600.0
# DICTIONARY_TIER=ingest (palier de la campagne, AD-9 ; `reason` la mène au plancher
#   sémantique Sonnet quand le majorant Opus dépasse le plafond — `micro` est refusé)
# Typage Opus des clauses (story 3.2) — deux lots séquentiels, sortie structurée sans texte de
# clause, regroupement et résolution bornés, coût réel calculé depuis l'usage avec remise Batch.
# TYPE_CLAUSES_MAX_BLOCKS_PER_REQUEST=10  TYPE_CLAUSES_MAX_INPUT_CHARS=60000
# TYPE_CLAUSES_MAX_REQUESTS_PER_BATCH=1000  TYPE_CLAUSES_MAX_OUTPUT_TOKENS=2048
# TYPE_CLAUSES_MAX_COST_EUR=12.0  TYPE_CLAUSES_BATCH_POLL_S=20.0  TYPE_CLAUSES_BATCH_TIMEOUT_S=7200.0
# TYPE_CLAUSES_STANDARD_CONCURRENCY=8  TYPE_CLAUSES_STANDARD_MAX_RETRIES=3
# TYPE_CLAUSES_STANDARD_RETRY_BASE_S=1.0
# TYPE_CLAUSES_MAX_ARTICLE_REFS=12  TYPE_CLAUSES_MAX_SCOPE_ARTICLES=20  TYPE_CLAUSES_MAX_RELATIONS=6
# TYPE_CLAUSES_REF_EXPANSION_MAX_BLOCKS=30
# TYPE_CLAUSES_DEFINITION_MAX_CHARS=120  TYPE_CLAUSES_DEFINITION_MAX_WORDS=12
# PERIMETRE_MAX_CHARS=4000 (longueur maximale du périmètre dérivé du corpus et rendu dans le préfixe
#   de *comprendre* ; au-delà, des catégories entières sont retirées, jamais une ligne coupée)
# Les deux caches de la facture (story 5.6, T5, décision du 03/09/2026). Mesuré sur le prototype de
#   navigation : une première requête après expiration du préfixe paie ≈ 0,28 € d'écriture de cache,
#   contre ≈ 0,015 € à chaud.
# PREFIX_KEEPALIVE_ENABLED=false — le maintien au chaud des préfixes n'a de sens que sous
#   `--min-instances=1`, drapeau décidé par `.github/workflows/deploy.yml` (AD-13), qui pose cette
#   variable à côté de lui. Faux partout ailleurs : poste de développement, révision candidate, tests.
# PREFIX_KEEPALIVE_S=3000.0 — dérivé, jamais choisi : le cache de préfixe vit une heure (3 600 s,
#   `MODEL_CAPS[...]["cache_ttl"]`), et 3 000 s laissent 600 s de marge sous l'expiration. Un
#   intervalle >= 3 600 s est refusé au démarrage : il paierait l'écriture qu'il prétend éviter.
# PREFIX_KEEPALIVE_MAX_PREFIXES=12 (quatre étapes × deux documents servis, avec de la place ; au-delà
#   le nouveau venu est refusé, jamais un ancien évincé)
# PREFIX_KEEPALIVE_MAX_COST_EUR_PER_DAY=1.0 — plafond dur, par quantième UTC. Un préfixe tenu en
#   continu coûte ≈ 0,015 € × 86 400 / 3 000 ≈ 0,43 €/jour ; le plafond atteint, le maintien
#   s'arrête et `/api/v1/sante` le publie (`caches.prefixes.plafond_du_jour_atteint`).
# RESPONSE_CACHE_ENABLED=true — le cache interne de réponses, clé **exacte** (question normalisée sur
#   sa seule forme, faits mot pour mot, doc_id, langue, empreintes d'ingestion, dictionnaire,
#   pipeline, prompts et seuils). Jamais sémantique : une faute de frappe est une requête payée.
#   Il n'est **armé que si la clé fournisseur est présente** — sans clé, il n'y a rien à économiser,
#   et aucune exécution hors ligne ne laisse d'état sur disque.
# RESPONSE_CACHE_TTL_S=604800.0 (sept jours ; les empreintes périment de toute façon plus vite)
# RESPONSE_CACHE_MAX_ENTRIES=200  RESPONSE_CACHE_MAX_BYTES=33554432 (le disque de Cloud Run est en
#   RAM, sous `--memory=1Gi` et `--concurrency=2` : deux bornes, parce qu'une seule ne borne rien)
