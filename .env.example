# Copier en .env — jamais commité. Le serveur et `python -m server.app.llm.models --check` le lisent.
ANTHROPIC_API_KEY=
# ENV=dev | prod ; ALLOW_UNGATED=true sert les documents sans gate (dev, J+1)
ENV=dev
ALLOW_UNGATED=true
# Taux de change appliqué aux prix USD/MTok d'Anthropic (AD-9)
USD_EUR=0.92
# Les seuils [HYPOTHÈSE] se surchargent par variable d'environnement (voir server/app/config.py) :
# QUOTE_MIN_CHARS=25  MAX_OPENS=6  NODE_WINDOW=30  SEARCH_LIMIT=20  MAX_COST_EUR_PER_REQUEST=0.10
# RATE_LIMIT_PER_MINUTE=10  RATE_LIMIT_PER_DAY=100  DEADLINE_S=55
