# Secrets et configuration locale
.env
.env.*
!.env.example
*.key
service-account*.json
# Crédentiels fédérés écrits dans le répertoire de travail par `auth@v3` sur un runner GitHub.
gha-creds-*.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/

# Données générées (ingestion, caches de modèles, index)
data/cache/
data/ingested/
*.sqlite
*.duckdb

# Node (si outillage front)
node_modules/

# OS / éditeurs
.DS_Store
.idea/
.vscode/
*.swp

# Méthode et références de travail : restent hors du dépôt public
_bmad/
_bmad-output/
_reference/
.claude/
.agents/

# Sources non redistribuées : téléchargées au build (server/ingest/fetch_source.py)
data/*/source.pdf
# La disposition committée publie ces sources par le pointeur ; seuls ces liens restent suivis.
!data/lux-guide/source.pdf
!data/axa-lu-optihome-2017/source.pdf
!data/baloise-lu-home-2-2024/source.pdf
# Les liens ci-dessus sont publics ; leurs octets dans les générations ne le sont jamais.
data/.publie/*/data/*/source.pdf
data/*/*.tmp
# Inode persistant des verrous `flock` de typage ; ne jamais l'unlink pendant qu'un concurrent attend.
data/*/.type-clauses.lock

# Artefacts locaux/CI du harness d'évals (cache et rapports reproductibles, jamais committés)
.cache/evals/
.evals/
eval-results.json
eval-results.md

# Story 4.5, B7 : le verrou de l'espace de publication est un état de processus, pas un artefact.
# Le bundle lui-même (`data/.publie/<gen>/`) et son pointeur sont **suivis** : ils portent le
# contenu servi de `data/manifest.json`, que l'image copie et qu'un checkout doit trouver.
data/.publie/.verrou
data/.publie/**/*.tmp
data/.publie/.*.tmp
