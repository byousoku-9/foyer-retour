  "claude-sonnet-5:a5476c9491724d37": {
    "certificate": {
      "messages_sha256": "0d36fa0d5c89c559ad24ab042676c7935b52d807986e6bc721e5d615043c2dc2",
      "model": "claude-sonnet-5",
      "schema_sha256": "7ba29250276671891e322154b2d1fd7c31f7463489308280c99a1aa9ebbe76d1",
      "system_sha256": "d0ca9a16619d3757a248e23f79644c64bedde0bec59cae11a0240a93473b9be8",
