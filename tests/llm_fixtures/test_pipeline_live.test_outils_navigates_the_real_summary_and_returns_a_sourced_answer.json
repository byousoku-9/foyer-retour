  "claude-sonnet-5:7c4ddbaf8f8ae6f0": {
    "request": "claude-sonnet-5:7c4ddbaf8f8ae6f0",
    "response": {
      "content": [
        {
          "parsed_output": null,
          "text": "{\"segments\":[{\"text\":\"Vous disposez de huit jours après votre emménagement pour déclarer votre arrivée à la commune.\",\"kind\":\"factuel\",\"claim_ids\":[\"c1\"]},{\"text\":\"Cette déclaration se fait au bureau de la population (Biergercenter) et non ailleurs.\",\"kind\":\"factuel\",\"claim_ids\":[\"c2\"]},{\"text\":\"Le délai court à partir de l'emménagement effectif, pas à partir de la signature du bail.\",\"kind\":\"factuel\",\"claim_ids\":[\"c3\"]},{\"text\":\"Comme les créneaux de rendez-vous partent vite, notamment en période de rentrée, il est conseillé de réserver en ligne avant même d'avoir les clés.\",\"kind\":\"factuel\",\"claim_ids\":[\"c4\"]}],\"claims\":[{\"claim_id\":\"c1\",\"text\":\"Vous disposez de huit jours pour déclarer votre arrivée au bureau de la population après l'emménagement.\",\"quotes\":[{\"block_id\":\"lux-guide:farrivee:3\",\"quote\":\"Vous disposez de huit jours pour déclarer votre arrivée au bureau de la population, souvent appelé Biergercenter.\"}]},{\"claim_id\":\"c2\",\"text\":\"La déclaration se fait à la commune, condition de tout le reste des démarches.\",\"quotes\":[{\"block_id\":\"lux-guide:farrivee:2\",\"quote\":\"Tout part de la commune. Sans cette déclaration, ni matricule, ni sécurité sociale, ni banque, ni école.\"}]},{\"claim_id\":\"c3\",\"text\":\"Le délai de huit jours court après l'emménagement, pas après la signature du bail.\",\"quotes\":[{\"block_id\":\"lux-guide:farrivee:10\",\"quote\":\"Huit jours après l'emménagement, pas après la signature du bail.\"}]},{\"claim_id\":\"c4\",\"text\":\"Il faut réserver un rendez-vous en ligne avant même d'avoir les clés, car les créneaux partent vite en période de rentrée.\",\"quotes\":[{\"block_id\":\"lux-guide:farrivee:9\",\"quote\":\"En période de rentrée, les créneaux partent vite, ce qui peut suffire à faire dépasser le délai de huit jours. Réservez avant même d'avoir les clés.\"}]}]}",
          "type": "text"
        }
