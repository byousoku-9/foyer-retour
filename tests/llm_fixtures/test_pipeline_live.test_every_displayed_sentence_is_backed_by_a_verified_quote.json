  "claude-sonnet-5:2bbc57978ed1425b": {
    "certificate": {
      "messages_sha256": "fa0600cecbf370a53d35462acc490a86af8b45615bad5a35a633cab6bba01bde",
      "model": "claude-sonnet-5",
      "schema_sha256": "0a5063978735600bb16689551fadda735fa4e22b5fd08c268819586e0393896c",
      "system_sha256": "9fc271f124c5c7abecc70aa1bd8353c1e5adbf79002158407391033c68fb075c",
      "tools_sha256": "8bcbde5dd8c5938707cbe825c910f242603ccea58949ede9d2971049dc516e69",
      "version": 2
    },
    "request": "claude-sonnet-5:2bbc57978ed1425b",
    "response": {
      "content": [
        {
          "parsed_output": null,
          "text": "{\"segments\":[{\"text\":\"Pour l'inscription scolaire, trois voies existent : l'école publique, les écoles européennes/internationales, ou le privé.\",\"kind\":\"factuel\",\"claim_ids\":[\"c1\"]},{\"text\":\"Il faut engager cette démarche en premier, avant même la recherche de logement.\",\"kind\":\"factuel\",\"claim_ids\":[\"c2\"]},{\"text\":\"L'inscription à la commune précède généralement l'inscription scolaire, et il faut anticiper les papiers à fournir.\",\"kind\":\"factuel\",\"claim_ids\":[\"c3\"]},{\"text\":\"Concernant les allocations familiales, elles sont versées sans condition de nationalité, seule la résidence compte.\",\"kind\":\"factuel\",\"claim_ids\":[\"c4\"]},{\"text\":\"Le montant de base et les suppléments selon l'âge sont précisés, ainsi que l'allocation de rentrée scolaire.\",\"kind\":\"factuel\",\"claim_ids\":[\"c5\",\"c6\"]}],\"claims\":[{\"claim_id\":\"c1\",\"text\":\"Trois voies coexistent pour scolariser un enfant : l'école publique, les écoles européennes/internationales, et le privé.\",\"quotes\":[{\"block_id\":\"lux-guide:fecole:3\",\"quote\":\"Trois voies coexistent, très différentes.\"},{\"block_id\":\"lux-guide:fecole:7\",\"quote\":\"Il existe par ailleurs des écoles internationales publiques, gratuites, avec des sections anglophone, francophone ou germanophone, très demandées. Enfin, des établissements privés proposent le baccalauréat international ou des cursus étrangers, avec des frais significatifs.\"}]},{\"claim_id\":\"c2\",\"text\":\"C'est la démarche la plus longue et contrainte, à engager avant la recherche de logement.\",\"quotes\":[{\"block_id\":\"lux-guide:fecole:3\",\"quote\":\"C'est la démarche la plus longue et la plus contrainte de toute l'installation, et celle qu'il faut engager en premier, avant même la recherche de logement.\"}]},{\"claim_id\":\"c3\",\"text\":\"L'inscription à la commune précède l'inscription scolaire ; il faut vérifier la section linguistique et rassembler certificat de radiation et bulletins.\",\"quotes\":[{\"block_id\":\"lux-guide:fecole:9\",\"quote\":\"L'inscription à la commune précède généralement l'inscription scolaire, et les places dans les sections les plus recherchées partent parfois un an à l'avance.\"},{\"block_id\":\"lux-guide:fecole:9\",\"quote\":\"Avant de quitter votre pays, demandez à l'école d'origine un certificat de radiation ainsi que les bulletins des dernières années\"}]},{\"claim_id\":\"c4\",\"text\":\"Les allocations familiales sont dues pour tout enfant résidant au Luxembourg, sans condition de nationalité.\",\"quotes\":[{\"block_id\":\"lux-guide:fallocations:3\",\"quote\":\"elles sont dues pour tout enfant résidant au Luxembourg, sans condition de nationalité\"}]},{\"claim_id\":\"c5\",\"text\":\"Le montant de base est de 315,04 euros par mois et par enfant, majoré selon l'âge.\",\"quotes\":[{\"block_id\":\"lux-guide:fallocations:4\",\"quote\":\"Le montant de base s'élève à 315,04 euros par mois et par enfant, majoré de 23,81 euros au-delà de six ans et de 59,44 euros au-delà de douze ans, valeurs applicables au 1er juin 2026.\"}]},{\"claim_id\":\"c6\",\"text\":\"Une allocation de rentrée scolaire automatique s'ajoute chaque année en août.\",\"quotes\":[{\"block_id\":\"lux-guide:fallocations:4\",\"quote\":\"S'y ajoute chaque année, en août, une allocation de rentrée scolaire de 115 euros pour un enfant de plus de six ans et de 235 euros au-delà de douze ans, versée automatiquement, sans aucune demande.\"}]}]}",
          "type": "text"
        }
      ],
